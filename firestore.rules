rules_version = '2';

// ============================================================
//  FIDGET SHOP — Firestore security rules
//
//  Deploy: Firebase console → Firestore Database → Rules tab →
//  paste this file → Publish.
//
//  ★ If you change ADMIN_EMAIL in js/config.js, change the email
//    in isAdmin() below (and in storage.rules) to match.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "legobele@gmail.com";
    }

    // Signed in + clicked the verification link. (The @intermetro.edu
    // domain gate was dropped Oct 1, 2026 — any verified email may order.)
    function isVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    // Catalog: everyone reads, only admin writes.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /deals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promoCodes/{code} {
      // Shopper checkout looks up a code by its exact ID (tx.get);
      // collection listing is denied to everyone except admins so
      // promo codes can't be enumerated.
      allow get: if isAdmin() || isVerifiedEmail();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // Shoppers may ONLY bump usedCount by exactly 1 when placing an
      // order (the client does this inside the order transaction).
      allow update: if isAdmin() || (
        isVerifiedEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usedCount"])
        && request.resource.data.usedCount == resource.data.usedCount + 1
      );
    }

    match /orders/{id} {
      // Orders can only be created by verified school emails (or the admin
      // placing test orders), and the order must belong to the signer,
      // start as "pending", and be for a grade we actually serve (8th–12th,
      // plus teachers).
      allow create: if (isVerifiedEmail() || isAdmin())
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "pending"
        && request.resource.data.grade in ["8th", "9th", "10th", "11th", "12th", "n/a (teacher)"];
      // Owners read their own orders; admin reads everything.
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      // Admin manages orders; owners may only cancel their own.
      allow update: if isAdmin() || (
        request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status == "cancelled"
      );
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == uid);
      // Created by the account owner right after signup.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isAdmin();
    }

    // Product reviews: only verified students may read (reviews embed
    // reviewer emails). Verified students may create one review per
    // product — the doc ID must be `${uid}_${productId}`. Only admin
    // edits/deletes.
    match /reviews/{id} {
      allow read: if isVerifiedEmail();
      allow create: if isVerifiedEmail()
        && id == request.auth.uid + "_" + request.resource.data.productId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.productId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Pickup locations for delivering orders: customers set their own
    // (they can't write /orders except to cancel, so this lives separately).
    match /pickupLocations/{orderId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      // The writer must own the order this pickup location belongs to.
      // (Admin can write too, for test orders placed from the admin account.)
      allow create: if (isVerifiedEmail() || isAdmin())
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.orderId == orderId
        && request.resource.data.pickupLocation is string;
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.orderId == orderId
        && request.resource.data.pickupLocation is string;
      allow delete: if isAdmin();
    }

    // Push-notification device tokens. Only the Cloud Functions touch these
    // (Admin SDK bypasses rules); clients register via registerFcmToken.
    match /fcmTokens/{id} {
      allow read, write: if isAdmin();
    }

    // Abandoned-cart mirrors, written by the owner's own devices.
    match /carts/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Marketing preferences (email opt-in), owned by the user.
    match /prefs/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
